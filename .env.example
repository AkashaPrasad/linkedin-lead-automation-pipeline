# ─── APIFY ───────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=harvestapi~linkedin-post-search
APIFY_COOKIE_ACTOR_ID=curious_coder/linkedin-post-search-scraper

# ─── LINKEDIN COOKIE (li_at) — only used when "Scrape with cookies" is enabled.
# Update via the admin UI rather than editing this by hand; never commit a real value.
LINKEDIN_COOKIE=

# ─── AI MODEL (choose ONE or provide both — script will prefer OpenAI if both present) ─
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# ─── APOLLO ──────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ─── BREVO (email sending) ───────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=yourname@decisionpinnacle.co
BREVO_SENDER_NAME=Decision Pinnacle

# ─── GOOGLE SHEETS ───────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ─── TELEGRAM ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_group_chat_id_here

# ─── PIPELINE SETTINGS ───────────────────────────────
MAX_EMAILS_PER_RUN=100
APIFY_MAX_POSTS=500
DAILY_EMAIL_CAP=100

# ─── PERSISTENT CONFIG (Railway Volume / equivalent) ──
# Set this to the mount path of a persistent volume (e.g. /data) on Railway
# or any other host. admin_config.json and templates.json will then live
# there instead of being baked into the Docker image — UI edits (query
# sets, scraping settings, email templates) survive redeploys. Leave unset
# for local dev (falls back to the repo root, unchanged behavior).
CONFIG_DIR=
